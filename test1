import time
import quarchpy


# 修改成你的模块连接地址。
# 示例形式可能是：
# "USB:QTLxxxx-xx-xxx"
# "TCP:192.168.1.100"
# "SERIAL:COM5"
MODULE_ADDRESS = "USB:你的模块地址"


def send(module, command: str) -> str:
    """发送命令并打印模块响应。"""
    print(f"> {command}")
    response = module.sendCommand(command)
    print(f"< {response}")
    return response


module = quarchpy.quarchDevice(MODULE_ADDRESS)

try:
    # 查看模块身份，确认连接正常
    send(module, "*IDN?")

    # 恢复默认配置
    send(module, "config:default state")

    # 配置 source 4：
    # 总长度 10 ms
    # 周期 500 us
    # 占空比 50%
    send(module, "source:4:bounce:length 10 ms")
    send(module, "source:4:bounce:period 500 us")
    send(module, "source:4:bounce:duty 50")

    # 将 PERST# 分配到 source 4
    send(module, "signal:perst:source 4")

    # 执行一次下电/上电，让配置好的 sequence 运行
    send(module, "run:power down")
    time.sleep(1)
    send(module, "run:power up")

    print("PERST# sequence 已执行")

finally:
    # 测试结束后恢复默认配置
    try:
        send(module, "config:default state")
    finally:
        module.closeConnection()
