import re
def is_section_heading(line: str, next_line: str) -> bool:
    number_pattern = r"^\s*\d+\.\d+(?:\.\d+)*\s*$"
    title_pattern = r"^\s*[A-Za-z][^\r\n]*$"

    return bool(
        re.match(number_pattern, line)
        and re.match(title_pattern, next_line)
    )


def split_text_with_sections(
    text: str,
    chunk_size: int = 4000,
    overlap: int = 400
):
    chunks = []
    lines = text.splitlines()

    current_section = "Unknown Section"
    buffer = ""
    i = 0

    while i < len(lines):
        line = lines[i].strip()
        next_line = lines[i + 1].strip() if i + 1 < len(lines) else ""

        if is_section_heading(line, next_line):
            current_section = f"{line} {next_line}"
            buffer += line + "\n" + next_line + "\n"
            i += 2
        else:
            buffer += lines[i] + "\n"
            i += 1

        while len(buffer) >= chunk_size:
            chunk_text = buffer[:chunk_size].strip()

            if chunk_text:
                chunks.append({
                    "id": len(chunks),
                    "section": current_section,
                    "text": chunk_text
                })

            buffer = buffer[chunk_size - overlap:]

    if buffer.strip():
        chunks.append({
            "id": len(chunks),
            "section": current_section,
            "text": buffer.strip()
        })

    return chunks




